# ── Salin ke .env lalu sesuaikan. JANGAN commit .env ──

# PostgreSQL
POSTGRES_USER=vokasia
POSTGRES_PASSWORD=vokasia_dev
POSTGRES_DB=vokasia
ConnectionStrings__Default=Host=localhost;Port=5432;Database=vokasia;Username=vokasia;Password=vokasia_dev

# Redis (BFF session store, cache, rate limit)
Redis__Connection=localhost:6379

# RabbitMQ (MassTransit)
RABBITMQ_USER=vokasia
RABBITMQ_PASS=vokasia_dev
RabbitMq__Host=localhost
RabbitMq__Username=vokasia
RabbitMq__Password=vokasia_dev

# MinIO (foto & PDF)
MINIO_USER=vokasia
MINIO_PASS=vokasia_dev
Minio__Endpoint=localhost:9000
Minio__AccessKey=vokasia
Minio__SecretKey=vokasia_dev
Minio__Bucket=vokasia

# OpenIddict (dev: ephemeral keys; prod: sertifikat — lihat PRD NFR-SEC)
OpenIddict__Issuer=http://localhost:5000

# SMTP / email transaksional
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=no-reply@vokasia.local

# Frontend (Next.js BFF)
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:5000
# GAP ditemukan+ditambal VOK-H4-E2 live-verification (DECISIONS.md D28) — lihat komentar panjang
# di .env lokal utk penjelasan lengkap: var ini utk redirect BROWSER (login/route.ts), beda dari
# API_INTERNAL_URL yg utk fetch server-to-server (callback/magic-link). SENGAJA TIDAK di-override
# di docker-compose.yml frontend.environment (nilainya sama baik host-dev maupun compose, krn
# browser selalu di host, resolve via port yg di-publish "5000:8080").
API_PUBLIC_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379
SESSION_SECRET=ganti_dengan_random_32+_karakter
# Harus SAMA PERSIS dengan client secret yang dipakai backend saat seed client BFF
# (OpenIddictSetup.cs baca env var ini juga; kalau kosong dua sisi jatuh ke fallback dev yang sama).
OIDC_BFF_CLIENT_SECRET=dev-only-secret-change-me

# Production-only (set in docker-compose.prod.yml / secret manager)
# Frontend__PublicUrl=https://app.example.id
# DataProtection__KeysPath=/var/lib/vokasia/keys
# OpenIddict__EncryptionCertificatePath=/run/secrets/openiddict/encryption.pfx
# OpenIddict__SigningCertificatePath=/run/secrets/openiddict/signing.pfx
# OpenIddict__EncryptionCertificatePassword=<secret>
# OpenIddict__SigningCertificatePassword=<secret>
# DataProtection__CertificatePath=/run/secrets/openiddict/dataprotection.pfx
# DataProtection__CertificatePassword=<secret>
# ForwardedHeaders__KnownIPNetworks=172.16.0.0/12

# Timezone job (Hangfire)
TZ=Asia/Jakarta
