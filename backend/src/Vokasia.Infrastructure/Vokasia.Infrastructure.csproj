<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vokasia.Domain\Vokasia.Domain.csproj" />
  </ItemGroup>

  <!-- Classlib biasa tidak otomatis dapat shared framework ASP.NET Core. Identity's
       IdentityBuilder extensions (AddDefaultTokenProviders dkk) hidup di situ. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <!-- VOK-H4-E1: OutboxDispatcher/AddVokasiaMassTransit/IdempotencyGuard hidup di sini (Messaging/)
         supaya Api & Worker berbagi kontrak yang sama - versi SAMA PERSIS dgn yang sudah direferensi
         Api/Worker sejak scaffold H1 (belum pernah benar-benar dipakai sampai ticket ini). -->
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <!-- VOK-H4-E3 §2: SmtpEmailSender - MailKit disebut eksplisit oleh ticket (bukan pilihan bebas
         sesi ini), dipakai jalur non-Development (lihat DependencyInjection.cs). -->
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
