<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Vokasia.Worker-2281657a-a7c8-4ade-b00f-afc4e1f4909d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- VOK-H4-E1 §2 PhotoUploadedConsumer: kompres+strip EXIF-GPS+thumbnail. Dependency BARU
         (bukan built-in .NET) - System.Drawing.Common tak lintas-platform (Windows-only sejak .NET
         6+, tak cocok container Linux) - ImageSharp satu-satunya opsi wajar cross-platform.
         Version DIKUNCI ke >=3.1.11 (bukan 3.1.5 awal) - consumer ini mendekode byte foto UPLOAD
         SISWA (input tak terpercaya per definisi), persis skenario ancaman dua advisory yang
         `dotnet build` tandai pada 3.1.5: CVE-2025-27598 (out-of-bounds write, GIF decoder, patch
         3.1.7) dan CVE-2025-54575 (infinite loop GIF comment block, patch 3.1.11) - 3.1.11 menutup
         keduanya. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vokasia.Domain\Vokasia.Domain.csproj" />
    <ProjectReference Include="..\Vokasia.Infrastructure\Vokasia.Infrastructure.csproj" />
  </ItemGroup>
</Project>
